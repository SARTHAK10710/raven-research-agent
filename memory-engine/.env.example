# Raven Memory Engine configuration (placeholders only; never put real secrets here).
# Copy to .env for local development. .env files are git-ignored.
# Variables use the RAVEN_MEMORY__ prefix; nested settings use "__" as the delimiter.

# Required: development | testing | staging | production
RAVEN_MEMORY__ENVIRONMENT=development

# Optional (defaults shown)
# RAVEN_MEMORY__APP_NAME=raven-memory-engine
# RAVEN_MEMORY__LOG_LEVEL=INFO

# Required: database connection settings (PostgreSQL via psycopg 3, Phase 8.2).
RAVEN_MEMORY__DATABASE__HOST=localhost
RAVEN_MEMORY__DATABASE__PORT=5432
RAVEN_MEMORY__DATABASE__NAME=raven
RAVEN_MEMORY__DATABASE__USER=raven_memory_role
RAVEN_MEMORY__DATABASE__PASSWORD=change-me
# RAVEN_MEMORY__DATABASE__SCHEMA_NAME=memory
# Connection pool (defaults shown; tune by measurement)
# RAVEN_MEMORY__DATABASE__POOL_SIZE=5
# RAVEN_MEMORY__DATABASE__MAX_OVERFLOW=10
# RAVEN_MEMORY__DATABASE__POOL_RECYCLE_SECONDS=1800
# RAVEN_MEMORY__DATABASE__CONNECT_TIMEOUT_SECONDS=10

# Required: S3-compatible object storage (Phase 8.3; 7.1 section 24.1).
# Local development: `docker compose up -d object-storage-test` (SeaweedFS) listens on
# 127.0.0.1:58333; its test-only keys are in docker/seaweedfs/s3.json. Create the bucket
# once; the application never creates buckets.
RAVEN_MEMORY__OBJECT_STORAGE__ENDPOINT_URL=http://127.0.0.1:58333
RAVEN_MEMORY__OBJECT_STORAGE__BUCKET=raven-memory
RAVEN_MEMORY__OBJECT_STORAGE__ACCESS_KEY_ID=change-me
RAVEN_MEMORY__OBJECT_STORAGE__SECRET_ACCESS_KEY=change-me
# Optional (defaults shown)
# RAVEN_MEMORY__OBJECT_STORAGE__REGION=us-east-1
# RAVEN_MEMORY__OBJECT_STORAGE__MULTIPART_THRESHOLD_BYTES=8388608
# RAVEN_MEMORY__OBJECT_STORAGE__MULTIPART_CHUNK_BYTES=8388608
# RAVEN_MEMORY__OBJECT_STORAGE__CONNECT_TIMEOUT_SECONDS=5
# RAVEN_MEMORY__OBJECT_STORAGE__READ_TIMEOUT_SECONDS=30
# RAVEN_MEMORY__OBJECT_STORAGE__MAX_ATTEMPTS=3

# Required: RabbitMQ for handoff messages (Phase 8.3 step 4; 7.1 section 24.3).
# Local development: `docker compose up -d broker-test` listens on 127.0.0.1:55672 with
# test-only credentials (see docker-compose.yml). Enable TLS outside development and testing.
RAVEN_MEMORY__BROKER__HOST=127.0.0.1
RAVEN_MEMORY__BROKER__PORT=55672
RAVEN_MEMORY__BROKER__VIRTUAL_HOST=raven_test
RAVEN_MEMORY__BROKER__USER=change-me
RAVEN_MEMORY__BROKER__PASSWORD=change-me
# Optional (defaults shown)
# RAVEN_MEMORY__BROKER__USE_TLS=false
# RAVEN_MEMORY__BROKER__CONNECT_TIMEOUT_SECONDS=5
# RAVEN_MEMORY__BROKER__CONFIRM_TIMEOUT_SECONDS=10

# Optional: outbox relay policy (owner-approved defaults; 7.4 section 22 defers final values)
# RAVEN_MEMORY__OUTBOX__BATCH_SIZE=100
# RAVEN_MEMORY__OUTBOX__MAX_ATTEMPTS=10
# RAVEN_MEMORY__OUTBOX__BACKOFF_BASE_SECONDS=2.0
# RAVEN_MEMORY__OUTBOX__BACKOFF_MAX_SECONDS=300.0
# RAVEN_MEMORY__OUTBOX__POLL_INTERVAL_SECONDS=2.0
